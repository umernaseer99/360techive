# Contact form delivery. Set these on the server (Plesk: Node.js panel, or a
# .env file next to the app) and restart the process.
#
# Nothing here belongs in git. .env is already ignored.

# Any SMTP server works: this is plain nodemailer, nothing is tied to one
# provider. Point it at a mailbox on your own domain, a transactional service
# such as SendGrid, Mailgun or SES, or Gmail. Port 465 is implicit TLS and
# anything else is treated as STARTTLS.
#
# Check credentials before relying on them:
#   npm run check:smtp            # connect and log in only
#   npm run check:smtp -- --send  # also send one real message
#
# IONOS hosted mail: the SMTP host is smtp.ionos.com, not the website domain.
# coinstudy.co and mail.coinstudy.co point at the web server, which does not
# answer on 465 or 587, so using either as SMTP_HOST fails to connect.
# The username is the full address.
SMTP_HOST=smtp.ionos.com
SMTP_PORT=465              # 465 for implicit TLS, 587 for STARTTLS
SMTP_USER=info@coinstudy.co
SMTP_PASS=

# Sender. A display name is allowed. It must be an address this mailbox is
# allowed to send as, so with IONOS keep it on the same domain as SMTP_USER.
SMTP_FROM=360 Techive <info@coinstudy.co>

# Using Gmail instead: host smtp.gmail.com, user the full address, and an App
# Password rather than the account password, which needs 2-Step Verification
# turned on first. Gmail only sends as the account itself, so SMTP_FROM has to
# be that same address.

# Where enquiries land. Defaults to SMTP_USER when unset.
CONTACT_TO=360techive@gmail.com

# CONTACT_FROM is an alias for SMTP_FROM and takes priority if both are set.
# Leave it unset when using SMTP_FROM above.

# Google Analytics 4. The live property (G-7867YNSS39) is the default in the
# code, so this only needs setting to point a build somewhere else. Set it to
# an empty value to disable analytics entirely for a build.
# NEXT_PUBLIC_ values are compiled into the browser bundle, so it applies at
# BUILD time, not when the process starts.
# NEXT_PUBLIC_GA_ID=
