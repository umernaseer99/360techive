# Contact form delivery. Set these on the server (Plesk: Node.js panel, or a
# .env file next to the app) and restart the process.
#
# Nothing here belongs in git. .env is already ignored.

SMTP_HOST=smtp.strato.de
SMTP_PORT=465              # 465 for implicit TLS, 587 for STARTTLS
SMTP_USER=you@yourdomain.tld
SMTP_PASS=

# Where enquiries land. Defaults to SMTP_USER when unset.
CONTACT_TO=360techive@gmail.com

# Envelope sender. Must be a mailbox this SMTP account may send as, otherwise
# the mail is rejected or lands in spam. Defaults to SMTP_USER.
CONTACT_FROM=you@yourdomain.tld

# Google Analytics 4. The live property (G-7867YNSS39) is the default in the
# code, so this only needs setting to point a build somewhere else. Set it to
# an empty value to disable analytics entirely for a build.
# NEXT_PUBLIC_ values are compiled into the browser bundle, so it applies at
# BUILD time, not when the process starts.
# NEXT_PUBLIC_GA_ID=
